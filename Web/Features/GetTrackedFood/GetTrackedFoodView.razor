@namespace Web.Features.GetTrackedFood
@layout MainLayout

<main class="container">
    <section class="section is-flex is-flex-direction-column">
        <h1 class="title is-size-1">Vandaag</h1>
        <span>Calorieën</span>
        <progress class="progress is-primary" value="30" max="100">
            40%
        </progress>

        <span>Eiwitten</span>
        <progress class="progress is-info" value="30" max="100">
            30%
        </progress>

        <span>Vetten</span>
        <progress class="progress is-warning" value="30" max="100">
            20%
        </progress>
    </section>

    <section class="section">
        <h2 class="title">Ontbijt</h2>

        <ol>
            <li class="columns">
                <div class="column">AH Halfvolle Yoghurt</div>
                <div class="column">
                    <div x-data="{ isVisible: false }" :class="isVisible && 'is-active'" class="dropdown is-small" x-on:click.outside="isVisible = false">
                        <div class="dropdown-trigger">
                            <button x-on:click="isVisible = !isVisible" class="button" aria-haspopup="true" aria-controls="dropdown-menu">
                                <span>Dropdown button</span>
                                <span class="icon is-small">
                                    <i class="fas fa-angle-down" aria-hidden="true"></i>
                                </span>
                            </button>
                        </div>
                        <div class="dropdown-menu" id="dropdown-menu" role="menu">
                            <div class="dropdown-content">
                                <a href="#" class="dropdown-item"> Dropdown item </a>
                                <a class="dropdown-item"> Other dropdown item </a>
                                <a href="#" class="dropdown-item is-active"> Active dropdown item </a>
                                <a href="#" class="dropdown-item"> Other dropdown item </a>
                                <hr class="dropdown-divider" />
                                <a href="#" class="dropdown-item"> With a divider </a>
                            </div>
                        </div>
                    </div>
                </div>
            </li>
            <li class="columns">
                <div class="column">Wasa volkoren cracker</div>
                <div class="column">
                    <div class="select is-primary">
                        <select>
                            <option>per 100g</option>
                            <option>per 13g</option>
                        </select>
                    </div>
                </div>
            </li>
            <li class="columns">
                <div class="column">100% Pindakaas</div>
                <div class="column">100% Pindakaas</div>
            </li>
        </ol>
    </section>
</main>

