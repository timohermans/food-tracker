@namespace Web.Features
@inherits LayoutComponentBase
@inject AntiforgeryStateProvider Antiforgery


<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <HeadOutlet />
    @* <link href="lib/bulma/bulma@1.0.1.css" rel="stylesheet" /> *@
    <link href="lib/bootstrap/bootstrap@5.3.3.css" rel="stylesheet" />

    <script defer src="lib/alpinejs/alpinejs@3.14.0.js"></script>
    <script defer src="lib/bootstrap/bootstrap@5.3.3.bundle.js"></script>
    <script defer src="lib/bootstrap/color-mode-switcher.js"></script>
    <script defer>
        document.addEventListener('htmx:configRequest', function(evt) {
            if (evt.detail.verb !== 'get') {
                const name = "@_csrfName";
                const value = "@_csrfToken";
                evt.detail.parameters[name] = value;
            }
        });
    </script>
</head>
<body>
    @Body
</body>
</html>

@code {
    private string? _csrfToken;
    private string? _csrfName;

    protected override void OnInitialized()
    {
        var token = Antiforgery.GetAntiforgeryToken();
        _csrfToken = token?.Value;
        _csrfName = token?.FormFieldName;
    }

}